# Example environment for the YAS Go processes. Copy to /etc/yas/yas.env,
# chmod 600, and fill in values from the secret store. Never commit real values.

# Shared
MYSQL_DSN=yas_app:CHANGE_ME@tcp(db.internal:3306)/yas_target?parseTime=true&tls=true
AMQP_URL=amqps://yas_app:CHANGE_ME@broker.internal:5671/yas

# Callback server (cmd/callbacks)
HTTP_ADDR=:8080
# Each process serves /metrics, /healthz, and /readyz on its own loopback port:
# callbacks 9091, outbox-relay 9092, soka-mo-worker 9093, soka-point-worker 9094,
# soka-charge-dispatcher 9095, soka-sms-dispatcher 9096,
# soka-renewal-dispatcher 9097, soka-open-question-scheduler 9098. Override one process with
# OPS_ADDR in a systemd drop-in, not here, or every process will try the same port.
# enforce (default) | report | off. Start with report against real provider
# traffic, confirm yas_ingress_denied_total stays at zero, then switch to enforce.
INGRESS_AUTH_MODE=enforce
# Provider source networks. Confirm with the provider before enforcing.
INGRESS_ALLOWED_CIDRS=
# Proxies whose X-Forwarded-For is trusted, e.g. the load balancer subnet.
INGRESS_TRUSTED_PROXY_CIDRS=
# Optional shared secret (>= 32 chars) sent as X-Callback-Token or Bearer.
INGRESS_TOKEN=
INGRESS_MAX_INFLIGHT=64

# Charge and SMS dispatchers stay disabled until reviewed; see docs/charge-dispatch.md and docs/sms-dispatch.md.
CHARGE_DISPATCH_ENABLED=false
SMS_DISPATCH_ENABLED=false
# The renewal system may start or stop recurring charges; see docs/soka-subscription-flow.md.
RENEWAL_DISPATCH_ENABLED=false
RENEWAL_MANAGE_SUBSCRIPTION_URL=
RENEWAL_SUBS_MANAGE_URL=
EXPECTED_DB=yas_target
